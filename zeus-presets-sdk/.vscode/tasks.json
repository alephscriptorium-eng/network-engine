{
  "version": "2.0.0",
  "windows": {
    "options": {
      "shell": {
        "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
        "args": ["-c"]
      }
    }
  },
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "echo": true,
    "reveal": "always",
    "revealProblems": "onProblem",
    "clear": false
  },
  "tasks": [
    // presentation.group:
    //   zeus-start  → servidores MCP/UI (splits en un panel)
    //   zeus-debug  → monitor player-ui-debug (panel aparte)
    //   zeus-stop   → operaciones de parada (panel compartido)
    //   zeus-test   → tests (panel compartido)

    {
      "label": "Start ▸ ALL",
      "detail": "Arranca lineas + editor + player + view-ui + firehose-mcp + firehose-view-ui.",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Start ▸ lineas",
        "Start ▸ editor-ui",
        "Start ▸ player-ui (DJ)",
        "Start ▸ view-ui",
        "Start ▸ firehose-mcp",
        "Start ▸ firehose-view-ui",
        "Start ▸ player-ui-debug"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Start ▸ Cache Explorer",
      "detail": "lineas :4111-4112 + view-ui :3015 — navegador DISK_02/LINEAS (stats MCP opcionales).",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Start ▸ lineas",
        "Start ▸ view-ui"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Start ▸ Firehose Explorer",
      "detail": "firehose-mcp :3008 + firehose-view-ui :3016 — MCP disco + navegador DISK_01/FIREHOSE.",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Start ▸ firehose-mcp",
        "Start ▸ firehose-view-ui"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Start ▸ Tablero ALEPH",
      "detail": "Seed presets ALEPH y luego lineas + player + debug monitor en paralelo.",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Seed ▸ aleph presets",
        "Start ▸ Tablero servidores"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Start ▸ Tablero servidores",
      "detail": "Solo servidores: lineas :4111-4112 + player :3013 + debug monitor (sin seed).",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Start ▸ lineas",
        "Start ▸ player-ui (DJ)",
        "Start ▸ player-ui-debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "Start ▸ solar-system",
      "detail": "MCP servers sun/moon/earth · puertos 4101-4103.",
      "type": "npm",
      "script": "start:solar",
      "isBackground": true,
      "presentation": { "group": "zeus-start", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Start ▸ lineas",
      "detail": "MCP servers linea-espana/linea-wp-historia · puertos 4111-4112.",
      "type": "npm",
      "script": "start:lineas",
      "isBackground": true,
      "presentation": { "group": "zeus-start", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Start ▸ editor-ui",
      "detail": "Editor de presets · http://localhost:3012.",
      "type": "npm",
      "script": "start:editor",
      "isBackground": true,
      "presentation": { "group": "zeus-start", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Start ▸ player-ui (DJ)",
      "detail": "Tablero ALEPH · Mesa DJ · http://localhost:3013.",
      "type": "npm",
      "script": "start:player",
      "isBackground": true,
      "presentation": { "group": "zeus-start", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Start ▸ player-ui-debug",
      "detail": "TOP console monitor + MCP server on :3014 (socket/REST → player-ui :3013).",
      "type": "npm",
      "script": "start:player-debug",
      "isBackground": true,
      "presentation": { "group": "zeus-debug", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Start ▸ view-ui",
      "detail": "Cache Explorer · navegador DISK_02/LINEAS · http://localhost:3015.",
      "type": "npm",
      "script": "start:view",
      "isBackground": true,
      "presentation": { "group": "zeus-start", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Start ▸ firehose-mcp",
      "detail": "MCP firehose disco · browse corpus DISK_01 · http://localhost:3008/mcp.",
      "type": "npm",
      "script": "start:firehose-mcp",
      "isBackground": true,
      "presentation": { "group": "zeus-start", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Start ▸ firehose-view-ui",
      "detail": "Firehose Explorer · navegador DISK_01/FIREHOSE · http://localhost:3016.",
      "type": "npm",
      "script": "start:firehose",
      "isBackground": true,
      "presentation": { "group": "zeus-start", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Seed ▸ aleph presets",
      "detail": "Carga presets ALEPH en el store local (una vez o tras cambios).",
      "type": "npm",
      "script": "seed:aleph",
      "presentation": { "group": "zeus-start", "panel": "shared", "clear": true },
      "problemMatcher": []
    },

    {
      "label": "Stop ■ ALL (kill all ports)",
      "detail": "Mata cualquier proceso escuchando en 4101-4103, 4111-4112, 3008, 3012-3016.",
      "type": "shell",
      "command": "npm run stop:ports -- \"Zeus: all ports stopped\" 4101 4102 4103 4111 4112 3008 3012 3013 3014 3015 3016",
      "presentation": { "group": "zeus-stop", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stop ■ solar-system",
      "detail": "Libera puertos 4101-4103.",
      "type": "shell",
      "command": "npm run stop:ports -- \"solar-system stopped\" 4101 4102 4103",
      "presentation": { "group": "zeus-stop", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stop ■ lineas",
      "detail": "Libera puertos 4111-4112.",
      "type": "shell",
      "command": "npm run stop:ports -- \"lineas stopped\" 4111 4112",
      "presentation": { "group": "zeus-stop", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stop ■ editor-ui",
      "detail": "Libera el puerto 3012.",
      "type": "shell",
      "command": "npm run stop:ports -- \"editor-ui stopped\" 3012",
      "presentation": { "group": "zeus-stop", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stop ■ player-ui (DJ)",
      "detail": "Libera el puerto 3013.",
      "type": "shell",
      "command": "npm run stop:ports -- \"player-ui stopped\" 3013",
      "presentation": { "group": "zeus-stop", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stop ■ player-ui-debug",
      "detail": "Libera el puerto 3014 (monitor TOP + MCP).",
      "type": "shell",
      "command": "npm run stop:ports -- \"player-ui-debug stopped\" 3014",
      "presentation": { "group": "zeus-stop", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stop ■ view-ui",
      "detail": "Libera el puerto 3015 (Cache Explorer).",
      "type": "shell",
      "command": "npm run stop:ports -- \"view-ui stopped\" 3015",
      "presentation": { "group": "zeus-stop", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stop ■ firehose-mcp",
      "detail": "Libera el puerto 3008 (firehose MCP disco).",
      "type": "shell",
      "command": "npm run stop:ports -- \"firehose-mcp stopped\" 3008",
      "presentation": { "group": "zeus-stop", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stop ■ firehose-view-ui",
      "detail": "Libera el puerto 3016 (Firehose Explorer).",
      "type": "shell",
      "command": "npm run stop:ports -- \"firehose-view-ui stopped\" 3016",
      "presentation": { "group": "zeus-stop", "panel": "shared", "clear": true },
      "problemMatcher": []
    },

    {
      "label": "Test ✓ smoke solar-system",
      "detail": "node test/smoke.mjs en @zeus/solar-system.",
      "type": "shell",
      "command": "npm run test:solar",
      "group": "test",
      "presentation": { "group": "zeus-test", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test ✓ smoke lineas",
      "detail": "node test/smoke.mjs en @zeus/linea-system.",
      "type": "shell",
      "command": "npm run test:lineas",
      "group": "test",
      "presentation": { "group": "zeus-test", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test ✓ e2e catalog demo",
      "detail": "node e2e/demo.mjs (servidores + catálogo + preset).",
      "type": "shell",
      "command": "npm run e2e",
      "group": "test",
      "presentation": { "group": "zeus-test", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test ✓ e2e deck demo",
      "detail": "node e2e/deck-demo.mjs (flujo DJ sobre lineas).",
      "type": "shell",
      "command": "npm run e2e:deck",
      "group": "test",
      "presentation": { "group": "zeus-test", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test ✓ e2e tablero aleph",
      "detail": "node e2e/tablero-aleph-demo.mjs (puente A↔B + presets ALEPH).",
      "type": "shell",
      "command": "npm run e2e:tablero",
      "group": "test",
      "presentation": { "group": "zeus-test", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test ✓ e2e view-ui",
      "detail": "node e2e/view-demo.mjs (browse API + manifest + wikitext + anchors + focus).",
      "type": "shell",
      "command": "npm run e2e:view",
      "group": "test",
      "presentation": { "group": "zeus-test", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test ✓ smoke firehose-mcp",
      "detail": "node test/smoke.mjs en @zeus/linea-firehose.",
      "type": "shell",
      "command": "npm run test:firehose-mcp",
      "group": "test",
      "presentation": { "group": "zeus-test", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test ✓ e2e firehose-links",
      "detail": "node e2e/firehose-links-demo.mjs (player firehose-links API).",
      "type": "shell",
      "command": "npm run e2e:firehose-links",
      "group": "test",
      "presentation": { "group": "zeus-test", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test ✓ e2e firehose",
      "detail": "node e2e/firehose-demo.mjs (browse DISK_01 + micropost normalize).",
      "type": "shell",
      "command": "npm run e2e:firehose",
      "group": "test",
      "presentation": { "group": "zeus-test", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test ✓ player-ui-debug smoke",
      "detail": "Smoke in-process del MCP monitor en :3014.",
      "type": "shell",
      "command": "npm run test:player-debug",
      "group": "test",
      "presentation": { "group": "zeus-test", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
