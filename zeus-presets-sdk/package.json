{
  "name": "zeus-presets-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "MCP catalog & presets SDK: presets SDK, solar/linea demo servers, editor/player/view UIs",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start:solar": "npm run start -w @zeus/solar-system",
    "start:lineas": "npm run start -w @zeus/linea-system",
    "start:editor": "npm run start -w @zeus/editor-ui",
    "start:player": "npm run start -w @zeus/player-ui",
    "start:player-debug": "npm run start -w @zeus/player-ui-debug",
    "start:view": "npm run start -w @zeus/view-ui",
    "start:firehose": "npm run start -w @zeus/firehose-view-ui",
    "start:firehose-mcp": "npm run start -w @zeus/linea-firehose",
    "start:all": "echo 'Equivalent to VS Code task Start ▸ ALL — run MCP/UI servers in parallel terminals:' && echo '  npm run start:lineas' && echo '  npm run start:editor' && echo '  npm run start:player' && echo '  npm run start:view' && echo '  npm run start:firehose-mcp' && echo '  npm run start:firehose' && echo '  npm run start:player-debug' && echo 'Or use VS Code: Terminal > Run Task > Start ▸ ALL'",
    "volumes:sync:firehose": "node scripts/volumes-sync-firehose.mjs",
    "volumes:init:lineas": "node scripts/volumes-init-lineas.mjs",
    "volumes:init:medidor": "node scripts/volumes-init-medidor.mjs",
    "test:sdk": "npm test -w @zeus/presets-sdk",
    "test:solar": "npm test -w @zeus/solar-system",
    "test:lineas": "npm test -w @zeus/linea-system",
    "test:firehose-mcp": "npm test -w @zeus/linea-firehose",
    "test:player-debug": "npm test -w @zeus/player-ui-debug",
    "canvas:generate": "node scripts/generate-sprint0-canvas.mjs",
    "docs:index": "node scripts/generate-docs-index.mjs",
    "env:sync-mcp": "node scripts/sync-mcp-json.mjs",
    "env:check-mcp": "node scripts/sync-mcp-json.mjs --check",
    "lint:env": "node scripts/lint-zeus-env.mjs",
    "seed:aleph": "node scripts/seed-aleph-presets.mjs",
    "stop:ports": "bash scripts/stop-ports.sh",
    "e2e": "node e2e/demo.mjs",
    "e2e:deck": "node e2e/deck-demo.mjs",
    "e2e:tablero": "node e2e/tablero-aleph-demo.mjs",
    "e2e:view": "node e2e/view-demo.mjs",
    "e2e:firehose": "node e2e/firehose-demo.mjs",
    "e2e:firehose-links": "node e2e/firehose-links-demo.mjs",
    "e2e:firehose-deck": "node e2e/firehose-deck-demo.mjs"
  },
  "devDependencies": {
    "chalk": "^5.4.1",
    "log-update": "^6.1.0",
    "socket.io-client": "^4.8.1"
  },
  "license": "AIPLv1"
}
